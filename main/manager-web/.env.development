VUE_APP_API_BASE_URL=/xiaozhi
#1. To make the web console work in mobile browsers, first start manager-api and get the server address (http://<LAN IP>:8002/xiaozhi)
#2. In manager-mobile/.env, set VITE_SERVER_BASEURL to your server address, run pnpm dev:h5 to get the H5 page address, and put it in VUE_APP_H5_URL below
#3. Mobile browsers opening the web page will then be redirected to the mobile-friendly H5 page
VUE_APP_H5_URL=